// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===== Account / auth =====

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  apiKeys      ApiKey[]
  auditLogs    AuditLog[]
  customers    Customer[]
  payments     Payment[]
  payouts      Payout[]
  virtualCards VirtualCard[]
  foreignAccounts ForeignAccount[]
  payrollRuns  PayrollRun[]
}

model ApiKey {
  id        String   @id @default(cuid())
  label     String
  keyHash   String   @unique // SHA-256 of the full key (never store the raw key)
  keyPrefix String   // first 12 chars for display (e.g. "nxp_test_8h2")
  mode      String   // "test" | "live"
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mode])
}

// ===== Customers =====

model Customer {
  id        String   @id @default(cuid())
  email     String?
  name      String?
  phone     String?
  userId    String?  // owner (null for the shared demo customer)
  createdAt DateTime @default(now())

  user             User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments         Payment[]
  virtualCards     VirtualCard[]
  foreignAccounts  ForeignAccount[]

  @@index([userId])
}

// ===== Payments =====

model Payment {
  id          String   @id @default(cuid())
  amount      Int      // in smallest currency unit (kobo/cents)
  currency    String
  channel     String   // card | bank | wallet
  status      String   // pending | succeeded | failed
  reference   String?  @unique
  description String?
  fees        Int      @default(0)
  customerId  String
  userId      String?  // owner (null for legacy shared demo data)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ===== Virtual cards =====

model VirtualCard {
  id              String   @id @default(cuid())
  brand           String   @default("visa")
  last4           String
  expMonth        Int
  expYear         Int
  currency        String
  spendingLimit   Int?
  spendingInterval String? // daily | monthly | yearly
  label           String?
  status          String   @default("active") // active | frozen | deleted
  customerId      String
  userId          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([userId])
  @@index([status])
}

// ===== Foreign accounts =====

model ForeignAccount {
  id            String   @id @default(cuid())
  currency      String   // USD | GBP | EUR | CNY
  accountName   String
  accountNumber String
  routingNumber String?  // routing | sort code | BIC | CNAPS
  bankName      String
  customerType  String   @default("individual") // individual | business
  status        String   @default("active")
  customerId    String
  userId        String?
  createdAt     DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([userId])
}

// ===== Payouts =====

model Payout {
  id          String   @id @default(cuid())
  amount      Int
  currency    String
  status      String   @default("pending") // pending | paid | failed
  destType    String   // bank | mobile | wallet
  destCountry String
  reference   String?  @unique
  reason      String?
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ===== Transactions (unified ledger) =====

model Transaction {
  id          String   @id @default(cuid())
  type        String   // payment | payout | fx_conversion | card_charge | refund
  amount      Int
  currency    String
  status      String   // succeeded | pending | failed
  description String?
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

// ===== Payroll =====

model PayrollRun {
  id             String   @id @default(cuid())
  status         String   @default("scheduled") // scheduled | paid | failed
  totalAmount    Int
  totalCurrency  String
  itemsCount     Int
  scheduledFor   DateTime
  userId         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// ===== Webhooks =====

model WebhookEvent {
  id            String    @id @default(cuid())
  type          String
  payload       String    // JSON string
  delivered     Boolean   @default(false)
  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  nextAttemptAt DateTime?
  responseCode  Int?
  createdAt     DateTime  @default(now())

  @@index([type])
  @@index([delivered, nextAttemptAt])
}

// ===== Audit log (compliance) =====

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?  // null = anonymous / system
  apiKeyId     String?  // which API key performed the action
  action       String   // e.g. "payment.create", "api_key.revoke"
  resourceType String   // "payment" | "payout" | "virtual_card" | ...
  resourceId   String
  ipAddress    String?
  userAgent    String?
  metadata     String?  // JSON string of before/after diff
  createdAt    DateTime @default(now())

  user User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

// ===== Idempotency (replay-safe POSTs) =====

model IdempotencyRecord {
  id              String   @id @default(cuid())
  key             String   @unique // the Idempotency-Key header value
  userId          String?
  endpoint        String   // e.g. "POST /v1/payments"
  requestBodyHash String   // SHA-256 of the request body (to detect mismatched replays)
  responseBody    String   // the cached response JSON
  responseStatus  Int
  createdAt       DateTime @default(now())
  expiresAt       DateTime // 24h from creation

  @@index([userId])
  @@index([expiresAt])
}
