# ════════════════════════════════════════════════════════════════════
# Nexora — Environment Variables Example
# ════════════════════════════════════════════════════════════════════
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file. It's already in .gitignore.
#
# All keys below are REQUIRED for full production operation unless marked
# OPTIONAL. Keys marked DEMO are used only by the local seed script.
# ════════════════════════════════════════════════════════════════════

# ── App config ──────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="Nexora"
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated list of allowed dev origins (for Next 16 allowedDevOrigins)
ALLOWED_DEV_ORIGINS=

# ── Database (Prisma) ───────────────────────────────────────────────
# SQLite for dev. For production use Postgres:
#   DATABASE_URL=postgresql://user:pass@host:5432/nexora?schema=public
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Set to 1 to enable Prisma query logging in dev (leaks PII — never in prod)
DEBUG_PRISMA=0

# ── Nexora internal API ─────────────────────────────────────────────
# Master key that can mint/revoke other API keys via /api/v1/api-keys.
# Generate with: openssl rand -hex 32
NEXORA_MASTER_KEY=change-me-to-a-64-char-hex-string

# HMAC secret for signing Nexora's own webhook payloads to your app.
# Generate with: openssl rand -hex 32
NEXORA_WEBHOOK_SECRET=change-me-to-a-64-char-hex-string

# ── PaySwitch / TheTeller integration (PaySwitch Ghana) ────────────
# The public "PaySwitch" API is TheTeller (https://theteller.net).
# NOTE: payswitch.africa (Quidvis) has NO public API — see README.
# Sign up at https://theteller.net/signup to get these credentials.
THETELLER_API_USER=TTM-000000
THETELLER_API_KEY=your-theteller-api-key
THETELLER_MERCHANT_ID=TTM-000000
THETELLER_BASE_URL=https://test.theteller.net
THETELLER_CHECKOUT_URL=https://checkout-test.theteller.net
THETELLER_REDIRECT_URL=http://localhost:3000/payment/callback

# ── Paystack (recommended Nigerian gateway) ────────────────────────
# Sign up at https://dashboard.paystack.com to get keys.
PAYSTACK_SECRET_KEY=YOUR_PAYSTACK_TEST_SECRET
PAYSTACK_PUBLIC_KEY=YOUR_PAYSTACK_TEST_PUBLIC
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# ── Flutterwave (alternative pan-African gateway) ───────────────────
FLW_SECRET_KEY=YOUR_FLW_TEST_SECRET
FLW_PUBLIC_KEY=YOUR_FLW_TEST_PUBLIC
FLW_ENCRYPTION_KEY=YOUR_FLW_ENCRYPTION_KEY
FLW_SECRET_HASH=your-flutterwave-webhook-hash
FLW_BASE_URL=https://api.flutterwave.com/v3

# ── Crypto / stablecoin providers ───────────────────────────────────
# For USDC/USDT buy/sell via a liquidity provider (e.g. MoonPay, Banxa,
# or a direct on-ramp). OPTIONAL until crypto features go live.
MOONPAY_API_KEY=
MOONPAY_WEBHOOK_SECRET=
ONRAMP_PROVIDER=moonpay

# ── eSIM provisioning ───────────────────────────────────────────────
# eSIM data plan provider (e.g. Airalo, eSIMX). OPTIONAL until eSIM
# features go live.
AIRALO_API_KEY=
AIRALO_API_SECRET=
AIRALO_BASE_URL=https://esim.accesspree.com

# ── Foreign account provisioning (USD/GBP/EUR/CNY) ──────────────────
# Partner bank APIs (e.g. Lead Bank, Mercury, Wise Platform, Currencycloud).
CURRENCYCLOUD_API_KEY=
CURRENCYCLOUD_LOGIN_ID=
CURRENCYCLOUD_BASE_URL=https://devapi.currencycloud.com

# ── Authentication ──────────────────────────────────────────────────
# NextAuth.js (when user auth is enabled)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# OAuth providers (OPTIONAL)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email / SMS / notifications ─────────────────────────────────────
# Resend for transactional email
RESEND_API_KEY=YOUR_RESEND_KEY
RESEND_FROM_EMAIL="Nexora <noreply@nexora.africa>"

# Twilio for SMS OTP
TWILIO_ACCOUNT_SID=YOUR_TWILIO_SID
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ── Rate limiting ───────────────────────────────────────────────────
# In-memory in dev; Upstash Redis in prod
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Observability ───────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
LOGTAIL_SOURCE_TOKEN=

# ── Feature flags ───────────────────────────────────────────────────
ENABLE_CRYPTO=false
ENABLE_ESIM=false
ENABLE_FOREIGN_ACCOUNTS=false
ENABLE_BUSINESS_PAYROLL=false

# ── Compliance / KYC ────────────────────────────────────────────────
# BVN verification (Nigeria) via Youverify or Smile Identity
YOUVERIFY_API_KEY=
SMILE_IDENTITY_PARTNER_ID=
SMILE_IDENTITY_API_KEY=

# ── Demo seed data (DEMO only — remove in prod) ─────────────────────
SEED_DEMO_USER_EMAIL=john.doe@nexora.africa
SEED_DEMO_API_KEY_TEST=nxp_test_8h2k9nbq01def456abc789
SEED_DEMO_API_KEY_LIVE=nxp_live_replacemeinproduction
